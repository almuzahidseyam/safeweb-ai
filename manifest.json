{
  "manifest_version": 3,
  "name": "SafeWeb AI",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "Experimental local image blur and transparent URL warnings. Does not certify page safety.",
  "permissions": ["activeTab", "tabs", "storage"],
  "action": { "default_popup": "popup/popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
